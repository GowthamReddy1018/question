# Optional comma-separated browser origins allowed to call the API.
TELUGU_QA_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8080,http://127.0.0.1:8080

# Google AI Studio / Gemini API key. Keep this on the server; never put it in script.js.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# SMTP settings for password-reset email. Configure all required values in a local .env file.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Optional provider email for higher MyMemory translation limits.
# Never commit a real credential to this file.
MYMEMORY_EMAIL=
